```css
/* Configuración general */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    color: #222;
}


/* Encabezado */

.header {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 40px 20px;
}

.header h1 {
    margin: 0 0 10px;
}


/* Menú */

.menu {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;

    padding: 15px;
    background-color: #444;
}

.menu a {
    color: white;
    text-decoration: none;
    padding: 10px 15px;
    background-color: #666;
    border-radius: 5px;
}

.menu a:hover {
    background-color: #888;
}


/* Secciones */

.section {
    width: 90%;
    max-width: 1100px;

    margin: 40px auto;
    padding: 30px;

    background-color: white;
    border: 2px solid #ddd;
    border-radius: 10px;
}

.section h2 {
    margin-top: 0;
}


/* Box Model */

.box-model-example {
    width: 300px;

    margin: 30px auto;
    padding: 30px;

    border: 10px solid #333;

    background-color: #ddd;
}

.box-content {
    padding: 30px;
    background-color: white;
    text-align: center;
}

.box-information {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.box-example {
    flex: 1 1 200px;

    padding: 20px;
    margin: 10px;

    border: 3px solid #333;
    background-color: #eee;
}

.block-example {
    display: block;

    margin: 20px 0;
    padding: 20px;

    background-color: #ddd;
    border: 2px solid #222;
}

.inline-example {
    display: inline;

    padding: 10px;
    border: 2px solid #222;
    background-color: #ddd;
}

.inline-block-example {
    display: inline-block;

    margin-top: 20px;
    padding: 20px;

    background-color: #bbb;
    border: 2px solid #222;
}


/* Position */

.position-container {
    position: relative;

    min-height: 250px;
    padding: 20px;

    border: 2px solid #aaa;
}

.position-static {
    position: static;

    padding: 20px;
    margin-bottom: 10px;

    background-color: #ddd;
}

.position-relative {
    position: relative;

    left: 30px;
    top: 10px;

    width: 200px;
    padding: 20px;

    background-color: #bbb;
}

.position-absolute {
    position: absolute;

    right: 20px;
    top: 30px;

    padding: 20px;

    background-color: #999;
}

.position-fixed {
    position: fixed;

    right: 20px;
    bottom: 20px;

    padding: 15px 20px;

    background-color: #222;
    color: white;

    border-radius: 5px;
    z-index: 2000;
}


/* Float y Clear */

.float-container {
    padding: 20px;
    border: 2px solid #aaa;
}

.float-left {
    float: left;

    width: 150px;
    padding: 30px;

    margin-right: 20px;

    background-color: #ccc;
    text-align: center;
}

.float-right {
    float: right;

    width: 150px;
    padding: 30px;

    margin-left: 20px;

    background-color: #999;
    text-align: center;
}

.clear-example {
    clear: both;

    padding: 20px;
    margin-top: 30px;

    background-color: #ddd;
    text-align: center;
}


/* Display */

.display-block {
    display: block;

    padding: 20px;
    margin-bottom: 10px;

    background-color: #ddd;
}

.display-inline {
    display: inline;

    padding: 15px;
    background-color: #bbb;
}

.display-inline-block {
    display: inline-block;

    margin-top: 20px;
    padding: 20px;

    background-color: #999;
}

.display-none {
    display: none;
}


/* Overflow */

.overflow-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.overflow-box {
    width: 200px;
    height: 130px;

    padding: 15px;

    border: 2px solid #333;
    background-color: #eee;
}

.visible {
    overflow: visible;
}

.hidden {
    overflow: hidden;
}

.scroll {
    overflow: scroll;
}

.auto {
    overflow: auto;
}


/* Visibility */

.visibility-visible {
    visibility: visible;

    padding: 20px;
    margin-bottom: 10px;

    background-color: #ddd;
}

.visibility-hidden {
    visibility: hidden;

    padding: 20px;
    margin-bottom: 10px;

    background-color: #aaa;
}

.visibility-collapse {
    visibility: collapse;

    padding: 20px;

    background-color: #888;
}


/* Z-Index */

.z-index-container {
    position: relative;
    height: 250px;
}

.z-box {
    position: absolute;

    width: 180px;
    height: 120px;

    padding: 40px 20px;

    text-align: center;
}

.z-one {
    left: 50px;
    top: 50px;

    background-color: #ccc;
    z-index: 1;
}

.z-two {
    left: 120px;
    top: 80px;

    background-color: #999;
    z-index: 2;
}

.z-three {
    left: 190px;
    top: 110px;

    background-color: #666;
    color: white;
    z-index: 3;
}


/* Flexbox */

.flex-container {
    display: flex;

    flex-direction: row;
    flex-wrap: wrap;
    flex-flow: row wrap;

    justify-content: space-between;
    align-items: center;
    align-content: center;

    gap: 20px;

    min-height: 180px;
    padding: 20px;

    border: 2px solid #aaa;
}

.flex-item {
    width: 150px;
    padding: 30px;

    text-align: center;
    background-color: #bbb;
}


/* Flex Direction */

.flex-direction-example {
    display: flex;
    flex-direction: row;

    gap: 10px;
}

.flex-direction-example div {
    padding: 30px;
    background-color: #bbb;
}


/* Flex Wrap */

.flex-wrap-example {
    display: flex;
    flex-wrap: wrap;

    gap: 10px;
}

.flex-wrap-example div {
    flex: 0 0 150px;

    padding: 25px;

    background-color: #aaa;
    text-align: center;
}


/* Justify Content */

.justify-example {
    display: flex;

    justify-content: space-around;

    gap: 10px;
}

.justify-example div {
    padding: 25px;
    background-color: #bbb;
}


/* Align Items */

.align-items-example {
    display: flex;

    align-items: center;

    height: 180px;
    gap: 10px;

    border: 2px solid #aaa;
}

.align-items-example div {
    padding: 25px;
    background-color: #bbb;
}


/* Align Content */

.align-content-example {
    display: flex;

    flex-wrap: wrap;
    align-content: space-around;

    height: 250px;
    gap: 10px;

    border: 2px solid #aaa;
}

.align-content-example div {
    width: 40%;

    padding: 20px;

    background-color: #aaa;
    text-align: center;
}


/* Flex Grow, Shrink y Basis */

.flex-items-example {
    display: flex;
    gap: 10px;
}

.flex-items-example div {
    padding: 20px;
    background-color: #bbb;
}

.grow {
    flex-grow: 2;
}

.shrink {
    flex-shrink: 1;
}

.basis {
    flex-basis: 250px;
}


/* Flex */

.flex-items-example .basis {
    flex: 1 1 200px;
}


/* Order */

.order-example {
    display: flex;
    gap: 10px;
}

.order-example div {
    padding: 30px;
    background-color: #aaa;
}

.order-one {
    order: 1;
}

.order-two {
    order: 2;
}

.order-three {
    order: 3;
}


/* Align Self */

.align-self-example {
    display: flex;

    align-items: flex-start;

    height: 180px;
    gap: 10px;

    border: 2px solid #aaa;
}

.align-self-example div {
    padding: 25px;
    background-color: #bbb;
}

.self-center {
    align-self: center;
}


/* Responsive */

.responsive-container {
    display: flex;

    flex-wrap: wrap;
    justify-content: center;

    gap: 20px;
}

.responsive-container article {
    flex: 1 1 250px;

    padding: 25px;

    border: 2px solid #aaa;
    background-color: #eee;
}


/* Footer */

footer {
    padding: 30px;

    background-color: #222;
    color: white;

    text-align: center;
}


/* Pantallas pequeñas */

@media (max-width: 700px) {

    .section {
        width: 95%;
        padding: 20px;
    }

    .menu {
        flex-direction: column;
        align-items: stretch;
    }

    .menu a {
        text-align: center;
    }

    .position-absolute {
        position: static;
        margin-top: 20px;
    }

    .position-container {
        min-height: auto;
    }

    .float-left,
    .float-right {
        float: none;
        width: 100%;
        margin: 10px 0;
    }

    .flex-container {
        flex-direction: column;
        align-items: stretch;
    }

    .flex-direction-example {
        flex-direction: column;
    }

    .justify-example {
        flex-direction: column;
    }

    .align-items-example {
        flex-direction: column;
        height: auto;
    }

    .align-content-example {
        height: auto;
    }

    .align-content-example div {
        width: 100%;
    }

    .flex-items-example {
        flex-direction: column;
    }

    .order-example {
        flex-direction: column;
    }

    .responsive-container {
        flex-direction: column;
    }

    .responsive-container article {
        width: 100%;
    }
}
```
